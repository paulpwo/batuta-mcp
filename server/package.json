{
  "name": "@paulpwo/batuta-mcp",
  "version": "0.2.2",
  "description": "MCP server for Ableton Live 12 (BatutaMCP). Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Osinga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulpwo/batuta-mcp.git",
    "directory": "server"
  },
  "homepage": "https://github.com/paulpwo/batuta-mcp#readme",
  "bugs": {
    "url": "https://github.com/paulpwo/batuta-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ableton",
    "ableton-live",
    "music-production",
    "claude"
  ],
  "private": true,
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "batuta-mcp": "dist/src/bin.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p ../loudness/tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/bin.js',0o755)\"",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "test": "pnpm run build && node --test --test-timeout=90000 \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
